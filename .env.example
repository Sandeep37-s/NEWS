# ==============================================================================
# AI-Powered News Aggregation Platform - Environment Configuration Template
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# PostgreSQL (Production / Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/news_platform
# SQLite (Zero-setup local testing): sqlite+aiosqlite:///./news_platform.db
DATABASE_URL=sqlite+aiosqlite:///./news_platform.db

# --- BACKEND API & SECURITY ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-super-secret-64-char-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OPENROUTER AI CONFIGURATION ---
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended models: deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MAX_TOKENS=500
OPENROUTER_TEMPERATURE=0.3

# --- BACKGROUND INGESTION WORKER ---
RSS_FETCH_INTERVAL_MINUTES=15
ENABLE_BACKGROUND_WORKER=true

# --- ROLLING VIRAL NEWS 30 SYSTEM ---
HOT_NEWS_LIMIT=30
HOT_NEWS_WINDOW_HOURS=12
HOT_NEWS_REFRESH_MINUTES=10
HOT_NEWS_MIN_SCORE=60
HOT_NEWS_AI_THRESHOLD=75
HOT_NEWS_USE_AI=true

# --- INITIAL SUPER ADMIN SEED ---
SUPERADMIN_EMAIL=admin@newsplatform.com
SUPERADMIN_PASSWORD=AdminSecurePassword123!
SUPERADMIN_NAME=Platform Administrator

# --- IMAGE / OBJECT STORAGE ---
# Local storage mode: local | Cloudinary mode: cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PUBLIC / FRONTEND URL CONFIGURATION ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_NAME=Chronicle News
NEXT_PUBLIC_SITE_DESCRIPTION=Global AI-curated and editorial news intelligence platform.
